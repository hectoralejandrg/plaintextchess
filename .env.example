# Production deployment environment (change deploy-server-docker).
#
# Copy to `.env` and edit: `cp .env.example .env`. The `.env` file is
# git-ignored (see .gitignore) and must NOT be committed: it is per-deployment
# configuration, and any secret you add belongs there, never in the image.
#
# Every value below has the same default inside docker-compose.prod.yml, so a
# bare `docker compose -f docker-compose.prod.yml up` works without a `.env`.

# --- Server -----------------------------------------------------------------

# Tier role. Keep `all`: the shipped deployment is the single-process monolith
# (no Redis). Do not switch without also adding a Redis service (design D1).
TIER=all

# Interface and port the server binds inside the container. The proxy targets
# ws-server:3000, so only change PORT if you also change the Caddyfile.
BIND=0.0.0.0
PORT=3000

# SQLite database path. Must stay under /data so it lands on the persistent
# `server-data` volume (design D5).
DATABASE_URL=sqlite:/data/app.db

# Reconnect grace window in seconds: how long a disconnected seat is held.
RECONNECT_GRACE_SECS=30

# Session lifetime in seconds (default 30 days). Minimum the server accepts is 60.
SESSION_TTL_SECS=2592000

# Log level/directives (tracing EnvFilter syntax).
RUST_LOG=info

# --- Box sizing -------------------------------------------------------------
#
# Ceilings, not reservations. Pick the row for this box in the "Sizing for the
# box" table of docs/deploy-docker.md and copy it here. The defaults below
# match the 4 GB+ row. Keep the SUM of the two memory limits comfortably below
# the box RAM: the OS and the Docker daemon need the rest.
#
# SERVER_MEM_LIMIT  - memory ceiling for the game server process.
# CADDY_MEM_LIMIT   - memory ceiling for the TLS proxy. The proxy is the first
#                     thing to hit the RAM wall (~120 KB per concurrent
#                     connection), so it usually gets the smaller share.
# NOFILE            - file-descriptor ceiling for the game server. One
#                     descriptor per concurrent client connection, so this is
#                     also the practical concurrent-player cap.
SERVER_MEM_LIMIT=1g
CADDY_MEM_LIMIT=1g
NOFILE=65536

# --- Proxy (Caddy) ----------------------------------------------------------

# Public site address. Two valid modes:
#   * Real public domain  -> Caddy issues and renews a certificate via ACME.
#   * localhost           -> no domain yet: Caddy uses a locally-trusted
#                            internal certificate (TLS still works).
# NEVER put a real-but-unowned placeholder (e.g. example.com): ACME issuance
# would fail at boot and could hit rate limits (design D2 "No-domain mode").
DOMAIN=localhost

# The HTTP-only test path (Caddy site `http://:8080`) is not published by
# default and needs no variable here; see config/Caddyfile. To use it before a
# domain exists, uncomment the 8080 port line in docker-compose.prod.yml.
