# The mail provider's credential (Resend or Postmark).
#
# Copy this file to `secrets/resend_key`, put the real credential in it, and
# keep it out of git:
#
#   cp secrets/resend_key.example secrets/resend_key
#   chmod 600 secrets/resend_key
#
# The server reads it from the path in `EMAIL_API_KEY_FILE`, which the
# production compose mounts at `/run/secrets/resend_key`. The credential never
# appears in the container's environment, so `docker inspect` does not show it.
re_PLACEHOLDER
